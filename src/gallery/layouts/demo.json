{
  "type": "column",
  "gap": 10,
  "children": [
    { "type": "label", "text": "热重载演示", "font": "title", "h": 26 },
    { "type": "label", "text": "来源: {origin}", "font": "meta", "h": 18 },
    { "type": "row", "gap": 8, "w": "match", "children": [
      { "type": "control", "id": "inc", "text": "+1", "style": "primary", "w": 72, "h": 32, "onClick": "inc" },
      { "type": "control", "id": "reset", "text": "清零", "style": "secondary", "w": 72, "h": 32, "onClick": "reset" },
      { "type": "spacer", "weight": 1 },
      { "type": "label", "text": "{clicks} 次点击", "w": "match", "h": 32, "align": "end" }
    ]},
    { "type": "scroll", "weight": 1, "gap": 8, "padding": 12, "children": [
      { "type": "row", "gap": 8, "children": [
        { "type": "label", "text": "卡片", "font": "section", "w": 48, "h": 22 },
        { "type": "spacer", "weight": 1 },
        { "type": "label", "text": "用 JSON 搭出来的一行", "font": "meta", "h": 22, "align": "end" }
      ]},
      { "type": "grid", "columns": 3, "gap": 8, "children": [
        { "type": "control", "text": "周一", "style": "secondary", "w": "match", "h": 34 },
        { "type": "control", "text": "周二", "style": "secondary", "w": "match", "h": 34 },
        { "type": "control", "text": "周三", "style": "secondary", "w": "match", "h": 34 },
        { "type": "control", "text": "周四", "style": "ghost", "w": "match", "h": 34 },
        { "type": "control", "text": "周五", "style": "ghost", "w": "match", "h": 34 },
        { "type": "control", "text": "回到顶部", "style": "ghost", "w": "match", "h": 34, "onClick": "scrollTop" }
      ]},
      { "type": "label", "text": "· 整块区域由这份 JSON 描述", "h": 20 },
      { "type": "label", "text": "· 保存本文件立即热重载", "h": 20 },
      { "type": "label", "text": "· margin / padding / weight / align 都支持", "h": 20 },
      { "type": "label", "text": "· 把上面 h 改小试试 Scroll 裁剪", "h": 20 },
      { "type": "label", "text": "· 字段类型写错会显示 行:列 错误", "h": 20 }
    ]}
  ]
}
