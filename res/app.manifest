<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- 启用 comctl32 v6 视觉样式：单行 EDIT 控件文字默认垂直居中，
       滚动条/按钮等也走现代主题，与 Ant Design 风格统一。
       未声明 dpiAware，保持原 DPI 虚拟化行为，避免固定像素布局在高分屏被缩小。 -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
